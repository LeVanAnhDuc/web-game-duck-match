#!/usr/bin/env bash
# Git hook: chan mot commit co subject khong dat Conventional Commits.
#
# Hook nay nam trong .githooks/ VA DUOC COMMIT, khong nam trong .git/hooks/ -
# thu muc do khong song sot qua `git clone`. Bat bang:
#
#     git config core.hooksPath .githooks
#
# Vi phai chay `git config` mot lan tren moi ban clone, hook nay chi la phan hoi
# nhanh, khong phai thu cuong che. Thu cuong che la job trong
# .github/workflows/commit-lint.yml - no khong the bi --no-verify.
set -uo pipefail

dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if ! bash "$dir/commit-lint.sh" --file "$1"; then
  printf '\n  Commit bi chan. Sua thong diep roi commit lai.\n' >&2
  printf '  Xem type nhan duoc : bash .githooks/commit-lint.sh --types\n' >&2
  printf '  Bo qua co y (hiem) : git commit --no-verify\n\n' >&2
  exit 1
fi
