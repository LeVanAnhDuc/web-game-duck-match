
# Bí mật — `.env.example` là bản mẫu và ĐƯỢC commit; `.env` là bản thật và không bao giờ commit.
.env
.env.*
!.env.example

# feature-flow branches into .worktrees/<feature>/ — an isolated checkout of this
# same repo, never content to commit.
.worktrees/

# Build & deps — the app lives in client/, the regression suite in automation-testing/
node_modules/
.next/
/client/out/
/client/out-auth/
/client/out-keep/
coverage/
*.tsbuildinfo
/client/next-env.d.ts

# Playwright (automation-testing/ and any local MCP session)
test-results/
playwright-report/
blob-report/
playwright/.cache/
.auth/

# --- Claude Code: theo doi config + agents + skills, bo qua worktrees/doc-state ---
/.claude/*
!/.claude/CLAUDE.md
!/.claude/settings.local.json
!/.claude/agents/
!/.claude/skills/
!/.claude/scripts/

# Playwright MCP scratch output (persona runs) — never content to commit.
.playwright-mcp/

# Cygwin/MSYS crash dumps from the Git Bash toolchain — never content to commit.
*.stackdump
