# Biến môi trường — BẢN MẪU. Copy thành `.env` rồi điền giá trị thật.
#
#   cp .env.example .env
#
# Trả lời câu hỏi: cần biến nào để chạy được dự án này?
# Trạng thái:     🟢 đủ — chạy dự án KHÔNG cần biến nào; đăng nhập Ducker ID là tuỳ chọn, mặc định TẮT
# Cập nhật:       2026-10-04
# Cập nhật khi:    code đọc một biến mới (process.env.X / os.getenv / os.Getenv / ...)
#
# HAI QUY TẮC
#   1. File này KHÔNG chứa giá trị bí mật. Chỉ tên biến + cách lấy giá trị.
#      `.env` là bản thật và đã bị .gitignore — giữ nguyên như vậy.
#   2. Danh sách này phải khớp CODE, không khớp tài liệu thiết kế. Biến nào code
#      không còn đọc thì xoá; biến nào code đọc mà thiếu ở đây là một cái bẫy.

# ─────────────────────────────────────────────────────────────
# Chạy game không cần biến nào — và đó là có chủ đích
# ─────────────────────────────────────────────────────────────
#
# `web-game-duck-match` chạy hoàn toàn ở trình duyệt: không server, không datastore,
# không API bên thứ ba, không khoá nào. Toàn bộ dữ liệu là `LevelConfig` tĩnh
# trong `src/levels/` và tiến độ người chơi trong localStorage.
#
#   pnpm install && pnpm dev
#
# Mọi biến NEXT_PUBLIC_* đều CÔNG KHAI — Next inline chúng vào bundle lúc build.
# Đừng bao giờ đặt bí mật ở đây (NFR-SEC-04).

# ─────────────────────────────────────────────────────────────
# Đường dẫn gốc của site
# ─────────────────────────────────────────────────────────────

# đọc bởi:      next.config.ts, src/auth/duckerConfig.ts (redirect_uri)
# bắt buộc khi: build để deploy lên GitHub Pages, và CHỈ lúc đó
# lấy ở đâu:    `.github/workflows/deploy.yml` tự đặt `/${{ github.event.repository.name }}`
#
# Bỏ trống = gốc site (`pnpm dev`, `out/` phục vụ ở gốc). Pages phục vụ repo này ở
# đường dẫn con `/web-game-duck-match` (KHÔNG có dấu / ở cuối), nên deploy đặt nó.
# Đặt ở máy sẽ làm `pnpm dev` hỏng đường dẫn asset — xem ADR-0006.
NEXT_PUBLIC_BASE_PATH=

# ─────────────────────────────────────────────────────────────
# Đăng nhập Ducker ID (tuỳ chọn, TẮT mặc định) — ADR-0012
# ─────────────────────────────────────────────────────────────
#
# OIDC Authorization Code + PKCE, public client (không backend nên KHÔNG có
# client_secret), chỉ lấy danh tính: tên, email, ảnh. Tiến độ chơi không đổi.
#
# Nút chỉ hiện khi cờ = "true" VÀ đủ cả 4 giá trị bên dưới. Thiếu một cái là tắt hẳn:
# không vẽ gì, không đụng storage, không gọi mạng. KHÔNG có giá trị mặc định nào trong
# code. `deploy.yml` cố ý không truyền các biến này — bản trên Pages không hiện nút.
#
# Chạy thử ở máy: `pnpm build && pnpm serve` rồi mở http://127.0.0.1:4173/ .
#   - redirect_uri phải đăng ký ở Ducker ID: http://127.0.0.1:4173/
#     (bản deploy sau này: https://levananhduc.github.io/web-game-duck-match/)
#   - thêm origin http://127.0.0.1:4173 vào `CORS_ORIGINS` của server Ducker ID
#     (trình duyệt gọi /oauth/token và /oauth/userinfo thẳng từ trang game).
#   - Biến NEXT_PUBLIC_* được inline lúc BUILD: đổi giá trị thì phải build lại.

# Cờ tính năng — chỉ đúng chuỗi "true" mới bật.
NEXT_PUBLIC_FEATURE_DUCKER_SIGN_IN=true
# Gốc của Ducker ID (nơi có /oauth/authorize, /oauth/token, /oauth/userinfo). Phải
# có scheme http(s)://, nếu không tính năng tự tắt.
NEXT_PUBLIC_DUCKER_ISSUER=http://localhost:3000
# client_id của game này, đăng ký trong admin console của Ducker ID.
NEXT_PUBLIC_DUCKER_CLIENT_ID=
# Scope xin khi đăng nhập — phải nằm trong allowed scopes của client.
NEXT_PUBLIC_DUCKER_SCOPE=openid profile email
# Trang hồ sơ trên Ducker ID mà menu tài khoản liên kết tới (tương đối với ISSUER).
NEXT_PUBLIC_DUCKER_PROFILE_PATH=/profile

# ─────────────────────────────────────────────────────────────
# Chỉ CI / kiểm bản deploy
# ─────────────────────────────────────────────────────────────

# đọc bởi:      e2e-live/deployed.spec.ts
# bắt buộc khi: chạy `pnpm verify:live` — KHÔNG có giá trị mặc định, thiếu là dừng ngay
# lấy ở đâu:    `.github/workflows/deploy.yml` truyền URL mà Pages vừa publish, để
#               job kiểm mở đúng bản vừa lên chứ không mở một URL viết cứng ở hai
#               chỗ rồi lệch nhau (ADR-0007). Ở máy thì đặt nếu muốn kiểm một
#               deployment khác.
# LIVE_URL=https://levananhduc.github.io/web-game-duck-match/

# đọc bởi:      scripts/check-bundle-size.mjs
# bắt buộc khi: không bao giờ — mặc định 200, đúng bằng ngưỡng NFR-PERF-07
# lấy ở đâu:    chỉ đặt khi muốn siết tạm thời để tìm chỗ phình
# BUNDLE_LIMIT_KB=200
